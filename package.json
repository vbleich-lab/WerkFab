{
  "name": "werkfab",
  "productName": "WerkFab",
  "version": "1.0.0-rc.45",
  "description": "WerkFab CAD/CAM – design and CNC machining, offline",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/vbleich-lab/WerkFab.git"
  },
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . WerkFab --platform=win32 --arch=x64 --out=dist --overwrite --icon=electron/icon.ico --app-version=1.0.0 --win32metadata.ProductName=WerkFab --win32metadata.FileDescription=\"WerkFab CAD/CAM\" \"--ignore=^/dist($|/)\" \"--ignore=^/node_modules($|/)\" \"--ignore=^/package-lock[.]json$\" \"--ignore=^/start[.]bat$\" \"--ignore=^/build-exe[.]bat$\" \"--ignore=^/build-web[.]bat$\" \"--ignore=^/tools($|/)\" \"--ignore=^/docs($|/)\" \"--ignore=^/rust($|/)\" \"--ignore=^/[.]claude($|/)\" \"--ignore=^/[.]git\" \"--ignore=^/[.]github($|/)\"",
    "build:web": "node tools/build-web.mjs",
    "build:kernel": "node tools/build-kernel.mjs",
    "test:kernel": "node tools/test-rust-kernel.mjs",
    "test:trim": "node tools/test-trim.mjs",
    "test:sketch": "node tools/test-sketchtools.mjs && node tools/test-sketchcorner.mjs && node tools/test-sketchoffset.mjs",
    "test:solver": "node tools/test-solver-arcs.mjs",
    "test:cam": "node tools/test-cam.mjs && node tools/test-rotary.mjs && node tools/test-cycle800.mjs && node tools/test-5axis.mjs",
    "test:hh": "node tools/test-heidenhain.mjs",
    "test:iso": "node tools/test-iso.mjs",
    "test:lathe": "node tools/test-lathe.mjs",
    "test:drawing": "node tools/test-drawing.mjs",
    "test:design": "node tools/test-gears.mjs && node tools/test-design.mjs && node tools/test-trace.mjs",
    "test:sheetmesh": "node tools/test-sheetmesh.mjs",
    "test:urdf": "node tools/test-urdf.mjs",
    "test:arrange": "node tools/test-arrange.mjs && node tools/test-family.mjs && node tools/test-share.mjs && node tools/test-motionplan.mjs && node tools/test-explode.mjs && node tools/test-fixtures.mjs && node tools/test-lessons.mjs && node tools/test-holefind.mjs",
    "test:assembly": "node tools/test-assembly.mjs",
    "test:nc": "node tools/test-nc.mjs",
    "test:fits": "node tools/test-fits.mjs",
    "test:lsv2": "node tools/test-lsv2.mjs",
    "test:netsend": "node tools/test-netsend.mjs",
    "test:i18n": "node tools/test-i18n.mjs",
    "test": "npm run test:trim && npm run test:sketch && npm run test:solver && npm run test:kernel && npm run test:cam && npm run test:hh && npm run test:iso && npm run test:lathe && npm run test:drawing && npm run test:design && npm run test:sheetmesh && npm run test:urdf && npm run test:arrange && npm run test:assembly && npm run test:nc && npm run test:measure && npm run test:fits && npm run test:lsv2 && npm run test:netsend && npm run test:i18n && npm run test:update",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "smoke": "node tools/smoke-app.mjs",
    "test:update": "node tools/test-update.mjs",
    "test:measure": "node tools/test-measure.mjs && node tools/test-meshmeasure.mjs"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "pyodide": "^314.0.8"
  },
  "homepage": "https://github.com/vbleich-lab/WerkFab",
  "author": {
    "name": "vbleich-lab"
  },
  "build": {
    "appId": "io.github.vbleich-lab.werkfab",
    "productName": "WerkFab",
    "copyright": "GPL-3.0-or-later",
    "directories": {
      "output": "dist/installers"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "css/**",
      "js/**",
      "vendor/**",
      "icons/**",
      "electron/**",
      "licenses/**",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "afterPack": "electron/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "fileAssociations": [
        {
          "ext": "ofab",
          "name": "WerkFab design",
          "description": "WerkFab design",
          "role": "Editor",
          "mimeType": "application/x-werkfab"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "WerkFab",
      "artifactName": "WerkFab-${version}-windows-x64-setup.${ext}",
      "include": "tools/installer.nsh"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Engineering",
      "icon": "icons/icon-512.png",
      "synopsis": "CAD/CAM for design and CNC machining",
      "artifactName": "WerkFab-${version}-linux-x86_64.${ext}",
      "fileAssociations": [
        {
          "ext": "ofab",
          "name": "WerkFab design",
          "description": "WerkFab design",
          "role": "Editor",
          "mimeType": "application/x-werkfab"
        },
        {
          "ext": "step",
          "name": "STEP model",
          "mimeType": "model/step",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "stp",
          "name": "STEP model",
          "mimeType": "model/step",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "igs",
          "name": "IGES model",
          "mimeType": "model/iges",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "iges",
          "name": "IGES model",
          "mimeType": "model/iges",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "stl",
          "name": "STL mesh",
          "mimeType": "model/stl",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "obj",
          "name": "OBJ mesh",
          "mimeType": "model/obj",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "3mf",
          "name": "3MF model",
          "mimeType": "model/3mf",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "ply",
          "name": "PLY mesh",
          "mimeType": "application/x-ply",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "icons/icon-512.png",
      "identity": null,
      "artifactName": "WerkFab-${version}-macos-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": "ofab",
          "name": "WerkFab design",
          "description": "WerkFab design",
          "role": "Editor",
          "mimeType": "application/x-werkfab",
          "rank": "Owner"
        },
        {
          "ext": [
            "step",
            "stp"
          ],
          "name": "STEP model",
          "mimeType": "model/step",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": [
            "igs",
            "iges"
          ],
          "name": "IGES model",
          "mimeType": "model/iges",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "stl",
          "name": "STL mesh",
          "mimeType": "model/stl",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "obj",
          "name": "OBJ mesh",
          "mimeType": "model/obj",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "3mf",
          "name": "3MF model",
          "mimeType": "model/3mf",
          "role": "Viewer",
          "rank": "Alternate"
        },
        {
          "ext": "ply",
          "name": "PLY mesh",
          "mimeType": "application/x-ply",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vbleich-lab",
        "repo": "WerkFab"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
